# Server
PORT=3000
NODE_ENV=development

# AI provider (opencode | gemini | groq)
AI_PROVIDER=opencode

# Opencode Go (OpenAI-compatible)
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=mimo-v2.5

# AI — Google Gemini via OpenAI-compatible SDK
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

# AI — Groq via OpenAI-compatible SDK
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Google Calendar OAuth2
GOOGLE_SERVICE_ACCOUNT={"type":"service_account",...}
GOOGLE_CALENDAR_ID=primary

# Facebook Messenger
FB_VERIFY_TOKEN=your_custom_webhook_verify_token
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
